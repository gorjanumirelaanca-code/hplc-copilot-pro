generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "sqlite"
}


model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  savedMethods  SavedMethod[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}


model SavedMethod {
  id            String   @id @default(cuid())
  name          String
  description   String?
  column        String?
  mobilePhase   String?
  buffer        String?
  pH            Float?
  flow          Float?
  temperature   Float?

  userId        String
  user          User     @relation(fields: [userId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}